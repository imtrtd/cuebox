{
  "name": "cuebox",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:mcp-widget": "esbuild src/mcp-widget/index.tsx --bundle --format=iife --platform=browser --target=es2020 --minify --outfile=public/cuebox-prompt-card-v1.js",
    "dev": "npm run build:mcp-widget && next dev",
    "build": "npm run build:mcp-widget && node scripts/prisma-generate.mjs && next build",
    "vercel-build": "npm run build:mcp-widget && node scripts/prisma-generate.mjs && node scripts/vercel-migrate.mjs && next build",
    "test:prisma-env": "node scripts/prisma-env.test.mjs",
    "start": "next start",
    "lint": "eslint",
    "test:mcp": "node scripts/smoke-mcp.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "build:catalog": "node scripts/build-promptcodex-catalog.mjs",
    "postinstall": "node scripts/prisma-generate.mjs",
    "cf:build": "npm run build:mcp-widget && node scripts/prisma-generate.mjs && opennextjs-cloudflare build",
    "cf:preview": "npm run cf:build && opennextjs-cloudflare preview",
    "cf:deploy": "npm run cf:build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@neondatabase/serverless": "^1.2.0",
    "@prisma/adapter-neon": "^6.19.3",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "next": "^16.4.2",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.1",
    "pg-cloudflare": "^1.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.12",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.151.1"
  }
}
