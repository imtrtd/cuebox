# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-a-long-random-string

# Prisma PostgreSQL
# Local (docker compose):
#   DATABASE_URL="postgresql://cuebox:cuebox@localhost:5432/cuebox?schema=public"
# Neon / Supabase / Vercel Postgres — paste the connection string from the dashboard.
# For pooled URLs (Neon/PgBouncer), append ?pgbouncer=true or use the direct URL for migrations.
DATABASE_URL="postgresql://cuebox:cuebox@localhost:5432/cuebox?schema=public"

# Public app URL for Auth.js (required in production)
# AUTH_URL=https://your-app.vercel.app
