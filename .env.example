# Auth.js -- generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-a-long-random-string

# PostgreSQL connection string (e.g. Neon, Supabase, Railway)
# Replace <USER>, <PASS>, <HOST>, and <DBNAME> with your actual values:
#   postgresql://<USER>:<PASS>@<HOST>:5432/<DBNAME>?sslmode=require
DATABASE_URL="postgresql://<USER>:<PASS>@<HOST>:5432/cuebox?sslmode=require"

# Public app URL for Auth.js in production
# AUTH_URL=https://your-app.vercel.app
